# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.

# ---- SQL Server connection (read-only account — see sql/000_readonly_login.sql) ----
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=AsiriDailyReport
DB_USER=asiri_report_app
DB_PASSWORD=change-me
# Azure SQL / TLS-enforced servers: leave DB_ENCRYPT=true.
# Local SQL Server with a self-signed dev certificate: set DB_TRUST_SERVER_CERT=true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# ---- Auth ----
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Approved users for this MVP (see section 7 of the brief — a handful of named
# users, no self-service signup). JSON array; generate each passwordHash with:
#   node scripts/hash-password.js "the user's password"
# IMPORTANT: Next.js expands $VAR references in .env files, so escape every
# literal "$" in the bcrypt hash as "\$" (bcrypt hashes always start with \$2a\$
# or \$2b\$) — otherwise Next.js silently mangles the hash and login will fail.
APP_USERS=[{"email":"friend@asirihealth.com","passwordHash":"\$2a\$10\$replace-with-a-real-bcrypt-hash","name":"Management User"}]
